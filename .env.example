# ─────────────────────────────────────────────────────────────
# SalesAI — Environment Variables (copy to .env and fill in)
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
LOG_LEVEL=debug

# ─── API ──────────────────────────────────────────────────────
API_PORT=5001
API_PUBLIC_URL=http://localhost:5001
VISITOR_PUBLIC_URL=http://localhost:5174
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# ─── Web apps ─────────────────────────────────────────────────
# Console (seller dashboard) + Visitor (public agent link)
VITE_API_URL=http://localhost:5001
VITE_LIVEKIT_URL=ws://localhost:7880
CONSOLE_PORT=5173
VISITOR_PORT=5174

# ─── Mobile (Expo dev build) ──────────────────────────────────
# Copy to apps/mobile/.env — Expo reads env from the app dir, NOT the repo root.
# Physical device: replace localhost with your Mac's LAN IP (ipconfig getifaddr en0);
# the app rewrites the LiveKit URL's localhost to the same host automatically.
EXPO_PUBLIC_API_URL=http://localhost:5001

# ─── Auth ─────────────────────────────────────────────────────
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

# ─── MongoDB (primary datastore + Atlas Vector Search) ────────
# Local dev uses the mongodb-atlas-local image (Vector Search enabled).
MONGODB_URI=mongodb://localhost:27017/salesai?directConnection=true
EMBEDDING_DIM=3072

# ─── Redis (cache / queue / pub-sub) ──────────────────────────
REDIS_URL=redis://localhost:6380

# ─── Object storage (S3-compatible / MinIO) ───────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=salesai-uploads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ─── LiveKit (WebRTC realtime) ────────────────────────────────
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ─── LLM / Embeddings ─────────────────────────────────────────
LLM_PROVIDER=openai
# Phase 7: ordered fallback chain for getLLM() with no explicit provider —
# tries each in order via @repo/resilience (timeout + jittered retry + circuit
# breaker per provider). Does NOT cover the agent-worker's voice pipeline —
# that one streams, and its own provider fallback is a separate, larger effort.
LLM_FALLBACK_CHAIN=openai,anthropic
OPENAI_API_KEY=
# Also the agent-worker's conversational model. Any gpt-5* model is pinned to
# reasoning_effort='none' there — see buildLLMOptions() in agent.js.
OPENAI_LLM_MODEL=gpt-5.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
ANTHROPIC_API_KEY=

# ─── Speech (chained pipeline alternative) ────────────────────
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=

# agent-worker voice pipeline (OpenAI). The spoken language is NOT set here —
# it comes from each agent's own persona.language.
OPENAI_STT_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# ─── Avatar providers (strategy; pick one via AVATAR_PROVIDER) ─
# tavus | simli | heygen | did | voice-only
AVATAR_PROVIDER=voice-only
TAVUS_API_KEY=
TAVUS_REPLICA_ID=
TAVUS_PERSONA_ID=
SIMLI_API_KEY=
SIMLI_FACE_ID=
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
DID_API_KEY=

# ─── Screen intelligence ──────────────────────────────────────
# AI-driven guided tour: playwright | browserbase | chrome-mcp
COBROWSE_PROVIDER=playwright
# Shadow the proven ordered runtime into the new reducer/obligation state.
# Observability only in this rollout slice; it does not change visitor behavior.
DYNAMIC_PLAYBOOK_STATE_SHADOW_ENABLED=false
# Cohort policy: off | shadow | canary. This replaces the boolean above;
# the old flag remains accepted during migration. Canary selection is stable
# per session and still leaves the legacy runtime authoritative.
DYNAMIC_PLAYBOOK_ROLLOUT_MODE=off
DYNAMIC_PLAYBOOK_CANARY_PERCENT=0
# Opt-in authority for accepted dynamic routes in eligible single-participant
# canary sessions. The active session supplies its own agent and product;
# no environment ID allowlist is required. Demo nodes additionally require Chrome MCP execution.
DYNAMIC_PLAYBOOK_ROUTE_EXECUTION_ENABLED=false
# Local replay-corpus export salt. Keep secret and stable per environment;
# never commit a real value or pass it via CLI/shell history.
REPLAY_ANONYMIZATION_SALT=
# Shadow by default: repetition decisions are measured but do not edit routes.
DYNAMIC_PLAYBOOK_MEMORY_POLICY_ENFORCEMENT_ENABLED=false
# Session-stable A/B scope for the advisory repetition reviewer (0-100).
# Unset/100 preserves current behavior; malformed values disable it.
DYNAMIC_PLAYBOOK_REPETITION_REVIEWER_PERCENT=100
# Optional OpenAI route prioritizer for shadow/canary state only. It selects
# among grounded rule-generated nodes; invalid/late output uses rules fallback.
# Requires OPENAI_API_KEY. Does not grant dynamic runtime authority.
DYNAMIC_PLAYBOOK_MODEL_PLANNER_ENABLED=false
DYNAMIC_PLAYBOOK_MODEL_PLANNER_MODEL=
# Independent second-LLM reviewer. Optional; can only suggest removing safe
# optional check/demo nodes, then the route validator still decides.
DYNAMIC_PLAYBOOK_MODEL_CRITIC_ENABLED=false
DYNAMIC_PLAYBOOK_MODEL_CRITIC_MODEL=
# Experimental canary only. Requires the dynamic shadow state and chrome-mcp;
# executes an accepted demo route after the spoken answer has completed.
DYNAMIC_PLAYBOOK_DEMO_EXECUTION_ENABLED=false

# Adaptive in-call survey. Also requires canary cohort and product.adaptiveSurvey.enabled with allowlisted fields.
DYNAMIC_PLAYBOOK_ADAPTIVE_SURVEY_ENABLED=false
# Visitor-visible surveys additionally require an opted-in product config and a
# single-participant canary session; the active session supplies agent/product identity.
# Read-only field opportunity observation in shadow cohort; no tool or visitor UI.
DYNAMIC_PLAYBOOK_ADAPTIVE_SURVEY_SHADOW_ENABLED=false
# Optional, rules-based proposal baseline; never shows a survey or calls an LLM.
DYNAMIC_PLAYBOOK_ADAPTIVE_SURVEY_SHADOW_PROPOSALS_ENABLED=false

# Background specialist orchestration. Global flags are kill-switches; each
# product must also opt in through PATCH /products/:id/engagement. No agent or
# product IDs belong in environment configuration.
MULTI_AGENT_ANALYSIS_ENABLED=false
MULTI_AGENT_PARTICIPANT_MEMORY_ENABLED=false
MULTI_AGENT_LEAD_CAPTURE_ENABLED=false
# off | shadow | canary. Shadow records proposals but never changes memory.
MULTI_AGENT_ROLLOUT_MODE=off
MULTI_AGENT_CANARY_PERCENT=0
# Optional background specialist override; defaults to OPENAI_LLM_MODEL.
MULTI_AGENT_MODEL=
MULTI_AGENT_ANALYST_TIMEOUT_MS=1200
# Optional binary override. Default: Playwright's supported Chrome for Testing binary.
CHROME_MCP_EXECUTABLE_PATH=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# ─── Video ingestion (worker-ingestion) ────────────────────────
# fluent-ffmpeg resolves plain `ffmpeg`/`ffprobe` off PATH — leave unset
# unless multiple ffmpeg installs conflict (Windows dev machines commonly
# have a stale one, e.g. from Anaconda, ahead of a proper one on PATH).
FFMPEG_PATH=
FFPROBE_PATH=

# ─── Website crawl (worker-ingestion) ──────────────────────────
# Max size for a PDF discovered while crawling a customer's site (enforced
# against the actual streamed byte count, not just Content-Length).
URL_CRAWL_MAX_PDF_BYTES=20971520

# ─── Vector store ─────────────────────────────────────────────
# mongodb (Atlas Vector Search, default) | qdrant
VECTOR_STORE=mongodb
# Phase 7: ordered fallback chain for retrieval reads (getVectorStore().query).
# Defaults to [VECTOR_STORE, the other one] if unset. Writes (upsert/delete)
# always go to the primary only — falling back a write to a different store
# would silently split data between the two, never to be reconciled.
VECTOR_STORE_FALLBACK_CHAIN=mongodb,qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
